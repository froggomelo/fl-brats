Bootstrap: docker
From: ubuntu:24.04

%files
    pyproject.toml /workspace/pyproject.toml
    uv.lock /workspace/uv.lock
    README.md /workspace/README.md
    src /workspace/src
    configs /workspace/configs

%post
    apt-get update && apt-get install -y --no-install-recommends ca-certificates curl && rm -rf /var/lib/apt/lists/*
    curl -LsSf https://astral.sh/uv/install.sh | sh
    export PATH=/root/.local/bin:$PATH
    export UV_HTTP_TIMEOUT="${UV_HTTP_TIMEOUT:-300}"
    uv python install 3.11
    cd /workspace && uv venv --python 3.11 .venv
    uv pip install --python /workspace/.venv/bin/python \
      torch==2.3.1+cu118 torchvision==0.18.1+cu118 \
      monai flwr hydra-core omegaconf mlflow optuna nibabel pandas numpy \
      matplotlib pydantic pydantic-settings python-dotenv psutil rich typer \
      pyyaml platformdirs \
      --index-url https://download.pytorch.org/whl/cu118 \
      --extra-index-url https://pypi.org/simple \
      --index-strategy unsafe-best-match
    uv pip install --python /workspace/.venv/bin/python --no-deps /workspace
    rm -rf /root/.cache/uv /root/.cache/pip

%environment
    export PATH=/workspace/.venv/bin:$PATH
    export PYTHONUNBUFFERED=1
    export PYTHONDONTWRITEBYTECODE=1
    export XDG_CACHE_HOME=/cache

%runscript
    exec fedbrats "$@"
