# Python and tooling
.venv/
__pycache__/
*.py[cod]
build/
dist/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
mlruns/
.ipynb_checkpoints/
.idea/
.vscode/
.DS_Store
.claude/

# Imaging data, run outputs, and caches live outside git. The canonical split
# (data/splits/) and client partitions (data/partitions/) are tracked.
data/raw/*
data/processed/*
!data/**/.gitkeep
outputs/*
!outputs/.gitkeep
cache/*
!cache/.gitkeep
checkpoints/*
!checkpoints/.gitkeep

# Logs are ignored except for hand-written run records (*.md).
logs/**
!logs/**/
!logs/.gitkeep
!logs/**/*.md
slurm-*.out

# Large binaries and private reading material
literature/
*.png
*.pdf
*.sif
.apptainer-cache/
.apptainer-tmp/
# Pretrained SAM checkpoints (hundreds of MB); verified by SHA-256 in the model configs.
artifacts/pretrained/
# Per-seed initial weights are generated artifacts kept beside the data, not in git.
artifacts/initial_weights/

# The research report is kept outside the code repository.
fl-research-report/
