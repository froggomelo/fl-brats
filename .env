PROJECT_NAME=fl-brats
PROJECT_DIR=/home-mscluster/ldemelo/fl-brats

# Canonical dataset root; the downloader writes to $FL_BRATS_DATA_ROOT/raw/brats2021.
FL_BRATS_DATA_ROOT=/datasets/$USER/fedbrats

# TCIA BraTS 2021 Faspex package link.
FASPEX_URL='https://faspex.cancerimagingarchive.net/aspera/faspex/public/package?context=eyJyZXNvdXJjZSI6InBhY2thZ2VzIiwidHlwZSI6ImV4dGVybmFsX2Rvd25sb2FkX3BhY2thZ2UiLCJpZCI6IjYzNiIsInBhc3Njb2RlIjoiNDM5YTVhZjM3NGRhYjk3OGExYjExMzA4MTcyZDhlMDdkY2Q5OWMzMSIsInBhY2thZ2VfaWQiOiI2MzYiLCJlbWFpbCI6ImhlbHBAY2FuY2VyaW1hZ2luZ2FyY2hpdmUubmV0In0='

FL_BRATS_OUTPUT_ROOT=$PROJECT_DIR/outputs
FL_BRATS_LOG_ROOT=$PROJECT_DIR/logs
FL_BRATS_CACHE_ROOT=$PROJECT_DIR/cache
FL_BRATS_CHECKPOINT_ROOT=$PROJECT_DIR/checkpoints
FL_BRATS_SCRATCH_ROOT=$PROJECT_DIR/cache/scratch
MLFLOW_TRACKING_URI=file:$FL_BRATS_OUTPUT_ROOT/mlruns
MLFLOW_EXPERIMENT_NAME=fl-brats

# Installed once and reused by the downloader for the Aspera client.
TOOLCHAIN_DIR=$PROJECT_DIR/.toolchain
