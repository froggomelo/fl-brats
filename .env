export PROJECT_NAME=fl-brats
export PROJECT_DIR=/home-mscluster/ldemelo/fl-brats

# Canonical dataset root; the downloader writes to $FL_BRATS_DATA_ROOT/raw/brats2021.
export FL_BRATS_DATA_ROOT=/datasets/$USER/brats
export FL_BRATS_RAW_ROOT="$FL_BRATS_DATA_ROOT/raw/brats2021/PKG - RSNA-ASNR-MICCAI-BraTS-2021/RSNA-ASNR-MICCAI-BraTS-2021/BraTS2021_TrainingSet"
export DATASET_INDEX_PATH="$FL_BRATS_DATA_ROOT/processed/brats2021_v1/dataset_index.csv"
export FL_BRATS_IMAGE=$PROJECT_DIR/apptainer/fl-brats.sif
export APPTAINER_IMAGE=$FL_BRATS_IMAGE

# TCIA BraTS 2021 Faspex package link.
export FASPEX_URL='https://faspex.cancerimagingarchive.net/aspera/faspex/public/package?context=eyJyZXNvdXJjZSI6InBhY2thZ2VzIiwidHlwZSI6ImV4dGVybmFsX2Rvd25sb2FkX3BhY2thZ2UiLCJpZCI6IjYzNiIsInBhc3Njb2RlIjoiNDM5YTVhZjM3NGRhYjk3OGExYjExMzA4MTcyZDhlMDdkY2Q5OWMzMSIsInBhY2thZ2VfaWQiOiI2MzYiLCJlbWFpbCI6ImhlbHBAY2FuY2VyaW1hZ2luZ2FyY2hpdmUubmV0In0='

export FL_BRATS_OUTPUT_ROOT=$PROJECT_DIR/outputs
export FL_BRATS_LOG_ROOT=$PROJECT_DIR/logs
export FL_BRATS_CACHE_ROOT=$PROJECT_DIR/cache
export FL_BRATS_CHECKPOINT_ROOT=$PROJECT_DIR/checkpoints
export FL_BRATS_SCRATCH_ROOT=$PROJECT_DIR/cache/scratch
export MLFLOW_TRACKING_URI=file:$FL_BRATS_OUTPUT_ROOT/mlruns
export MLFLOW_EXPERIMENT_NAME=fl-brats

# Installed once and reused by the downloader for the Aspera client.
export TOOLCHAIN_DIR=$PROJECT_DIR/.toolchain
