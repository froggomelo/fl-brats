PROJECT_NAME=fl-brats
FL_BRATS_DATA_ROOT=/datasets/$USER/brats
# FASPEX_URL='paste the TCIA Faspex package URL here'
FL_BRATS_OUTPUT_ROOT=/path/to/outputs
FL_BRATS_LOG_ROOT=/path/to/logs
FL_BRATS_CACHE_ROOT=/path/to/cache
FL_BRATS_CHECKPOINT_ROOT=/path/to/checkpoints
FL_BRATS_SCRATCH_ROOT=/path/to/scratch
MLFLOW_TRACKING_URI=file:/path/to/outputs/mlruns
MLFLOW_EXPERIMENT_NAME=fl-brats
APPTAINER_IMAGE=/path/to/fl-brats.sif
APPTAINER_CACHEDIR=/path/to/cache/apptainer
APPTAINER_TMPDIR=/path/to/scratch/apptainer
CUDA_VISIBLE_DEVICES=0
PYTHONHASHSEED=42
OMP_NUM_THREADS=4
MKL_NUM_THREADS=4
NUMEXPR_NUM_THREADS=4
TOKENIZERS_PARALLELISM=false
WANDB_DISABLED=true
